# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Run history before output redirected
run_hist/*
!run_hist/.gitkeep

# Debugging files
debugging/*
!debugging/.gitkeep

# macOS
.DS_Store

# Local archives / bundles
*.tar.gz

# Reference papers kept alongside the code (git add -f to track one on purpose)
*.pdf
# Run output lives OUTSIDE this repo, in ../spinbasis_data_2d (submit.sh's
# default RUN_ROOT). The old in-repo location stays ignored so a leftover copy
# can never make the tree dirty (submit.sh refuses to submit from a dirty tree).
spinbasis_data/
